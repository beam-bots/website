{
  "name": "beam-bots-light",
  "type": "light",
  "colors": {
    "editor.background": "#faf9f6",
    "editor.foreground": "#55515f"
  },
  "tokenColors": [
    {
      "scope": [
        "keyword"
      ],
      "settings": {
        "foreground": "#7228bb"
      }
    },
    {
      "scope": [
        "entity"
      ],
      "settings": {
        "foreground": "#076b70"
      }
    },
    {
      "scope": [
        "string",
        "storage"
      ],
      "settings": {
        "foreground": "#7228bb"
      }
    },
    {
      "scope": [
        "constant"
      ],
      "settings": {
        "foreground": "#076b70"
      }
    },
    {
      "scope": [
        "comment"
      ],
      "settings": {
        "foreground": "#686270",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#55515f"
      }
    }
  ]
}
